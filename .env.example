# Copy to .env for local development. On Vercel, set these under
# Settings -> Environment Variables.

# --- ImageKit -------------------------------------------------------------
# The paintings and all their metadata live here, not in this repo.
# Keys: https://imagekit.io/dashboard/developer/api-keys
# Endpoint: https://imagekit.io/dashboard/url-endpoints

# Server only. Never expose this — it is full read/write on the media library.
IMAGEKIT_PRIVATE_KEY=private_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Server-side URL building.
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# Same value, needed in the browser by the next/image loader
# (lib/imagekit-loader.ts). Safe to expose — it is a public CDN hostname.
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# Only needed once uploads happen from the browser. Safe to expose.
IMAGEKIT_PUBLIC_KEY=public_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Verifies ImageKit webhooks at /api/webhooks/imagekit so the site refreshes
# when a painting is added or edited. Create it in the ImageKit dashboard
# under Webhooks. Not required until that route exists.
IMAGEKIT_WEBHOOK_SECRET=

# --- Supabase -------------------------------------------------------------
# Accounts, favourites and likes. Not required until that work lands.
# https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin ---------------------------------------------------------------
# Single shared password for /admin. Visitors never need this; it is separate
# from the Google sign-in used for favourites.
ADMIN_PASSWORD=
